FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DBT_PROJECT_DIR=/app/dbt/financial_data \
    DBT_PROFILES_DIR=/app/dbt/financial_data

WORKDIR /app

RUN groupadd --gid 10001 fdp \
    && useradd \
        --uid 10001 \
        --gid fdp \
        --create-home \
        --shell /bin/bash \
        fdp

COPY pyproject.toml ./
COPY src ./src

RUN python -m pip install --no-cache-dir . \
    && python -m pip check

COPY --chown=fdp:fdp dbt/financial_data /app/dbt/financial_data

USER fdp

CMD ["python", "--version"]